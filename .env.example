# LM Studio (OpenAI-compatible server)
SB_LMSTUDIO_BASE_URL=http://localhost:1234/v1
SB_LMSTUDIO_API_KEY=lm-studio

# Model ids exactly as listed by GET /v1/models. Upgrading a model = change these only.
SB_READER_MODEL=
SB_CHAT_MODEL=
SB_EMBED_MODEL=
# Task prefixes, empty for most models. Keep the quotes: they preserve the trailing space.
# nomic-embed-text-v1.5 needs:
#   EMBED_DOC_PREFIX="search_document: "
#   EMBED_QUERY_PREFIX="search_query: "
EMBED_DOC_PREFIX=""
EMBED_QUERY_PREFIX=""

# Human-facing folder you browse in File Explorer. Must be OUTSIDE this repo.
SB_LIBRARY_DIR=~/Documents/StudyBuddy
# Internal working area (queue, index, failed). Must be outside the repo and not inside the library.
SB_DATA_DIR=~/StudyBuddyData

SB_SUBJECTS_FILE=subjects.json
SB_TAG_TIMEOUT_SECONDS=300

# Telegram (needed from chunk 7)
TELEGRAM_BOT_TOKEN=
TELEGRAM_USER_ID=

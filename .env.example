# LM Studio (OpenAI-compatible server)
SB_LMSTUDIO_BASE_URL=http://localhost:1234/v1
SB_LMSTUDIO_API_KEY=lm-studio

# Model ids exactly as listed by GET /v1/models. Upgrading a model = change these only.
SB_READER_MODEL=
SB_CHAT_MODEL=
SB_EMBED_MODEL=
# Task prefixes, empty for most models. Keep the quotes: they preserve the trailing space.
# nomic-embed-text-v1.5 needs:
#   EMBED_DOC_PREFIX="search_document: "
#   EMBED_QUERY_PREFIX="search_query: "
EMBED_DOC_PREFIX=""
EMBED_QUERY_PREFIX=""

# Human-facing folder you browse in File Explorer. Must be OUTSIDE this repo.
SB_LIBRARY_DIR=~/Documents/StudyBuddy
# Internal working area (queue, index, failed). Must be outside the repo and not inside the library.
SB_DATA_DIR=~/StudyBuddyData

# Long edge (px) the READER image is downscaled to; see docs/reader-image-policy.md.
SB_READER_MAX_EDGE=2048

# Chat: context size to assume if LM Studio cannot report it (normally leave empty), and the room kept for each answer.
SB_CHAT_CONTEXT_TOKENS=
SB_CHAT_MAX_ANSWER_TOKENS=700
# Also search with two rephrasings of each question (1 = on, 0 = off). Costs one extra short model call.
SB_CHAT_EXPAND_QUERIES=1

# Folder of page images + same-name .txt hand-corrected references for the bake-off. Outside the repo.
SB_SAMPLES_DIR=~/StudyBuddyData/samples

SB_SUBJECTS_FILE=subjects.json
SB_TAG_TIMEOUT_SECONDS=300

# Telegram (needed from chunk 7)
TELEGRAM_BOT_TOKEN=
TELEGRAM_USER_ID=

# Web UI (python -m studybuddy). Keep 127.0.0.1: there is no login, so any other value
# (0.0.0.0, a LAN address) lets everyone on the network read and delete your library.
SB_HOST=127.0.0.1
SB_PORT=7860
